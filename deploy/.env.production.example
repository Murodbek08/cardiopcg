# CardioPCG AI - production environment TEMPLATE. PLACEHOLDERS ONLY.
# On the server copy to /opt/cardiopcg/shared/.env (chmod 600, owner deploy) and generate every secret THERE:
#   openssl rand -hex 32        (passwords / JWT)       openssl rand -base64 32   (PII_ENCRYPTION_KEY)
# Use hex/alphanumeric passwords only: they are embedded into DATABASE_URL / REDIS_URL by docker-compose.prod.yml.
# NEVER commit the real file, never paste `docker compose config` output anywhere (it prints these values).

# ---------- Ports (127.0.0.1 only). PLACEHOLDER range 18400-18409: confirm with deploy/scripts/recon.sh ----------
CARDIOPCG_API_PORT=18400
CARDIOPCG_WEB_PORT=18401

# ---------- General ----------
# APP_VERSION / GIT_COMMIT are exported by deploy.sh per release (do not set them here)
PUBLIC_URL=https://cardiopcgai.189.uz
ALLOWED_ORIGINS=https://cardiopcgai.189.uz
ALLOWED_HOSTS=cardiopcgai.189.uz,localhost,127.0.0.1
LOG_LEVEL=info
DOCS_ENABLED=false
TZ=Asia/Tashkent

# ---------- PostgreSQL ----------
POSTGRES_DB=cardiopcg
POSTGRES_USER=cardiopcg_app
POSTGRES_PASSWORD=<GENERATE_HEX_32>

# ---------- Redis ----------
REDIS_PASSWORD=<GENERATE_HEX_32>

# ---------- MinIO / S3 (buckets are private; app uses a least-privilege user created by minio-init) ----------
MINIO_ROOT_USER=<GENERATE_USER>
MINIO_ROOT_PASSWORD=<GENERATE_HEX_32>
S3_BUCKET_AUDIO=pcg-audio
S3_BUCKET_REPORTS=pcg-reports
S3_ACCESS_KEY=<GENERATE_APP_ACCESS_KEY_20_CHARS>
S3_SECRET_KEY=<GENERATE_HEX_32>

# ---------- Auth / crypto ----------
JWT_SECRET=<GENERATE_HEX_32_openssl_rand_-hex_32>
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
PASSWORD_PEPPER=<GENERATE_HEX_32>
PII_ENCRYPTION_KEY=<BASE64_OF_32_RANDOM_BYTES>
PII_HASH_PEPPER=<GENERATE_HEX_32>

# ---------- Antivirus (optional; enable with the `av` compose profile) ----------
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false

# ---------- AI ----------
ANALYSIS_SERVICE_IMPL=app.services.ai_adapter:build
DEEPSEEK_API_KEY=<SET_ON_SERVER_ONLY>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- Backups (used by deploy/scripts/backup.sh; age PUBLIC key only - the private key never lives on the server) ----------
BACKUP_AGE_RECIPIENT=<age1...PUBLIC_KEY>
BACKUP_DIR=/opt/cardiopcg/backups
BACKUP_RETENTION_DAYS=7
# optional offsite via rclone remote name, e.g. offsite:cardiopcg-backups
BACKUP_RCLONE_REMOTE=

# ---------- Object store image ----------
# MinIO community images were withdrawn from Docker Hub/Quay (verified 2025-11): `docker pull` of the default below may FAIL.
# Then set MINIO_IMAGE to an image you control (own registry / locally built) of the same MinIO release, or another S3-compatible store.
# MINIO_IMAGE=registry.example/minio:RELEASE.2025-09-07T16-13-09Z
