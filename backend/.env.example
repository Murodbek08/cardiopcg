# CardioPCG AI backend - placeholders only. Real values live in the server-side .env (chmod 600), never in git.
APP_ENV=production
APP_VERSION=1.0.0
GIT_COMMIT=<git-sha>
PUBLIC_URL=https://cardiopcgai.189.uz
ALLOWED_ORIGINS=https://cardiopcgai.189.uz
ALLOWED_HOSTS=cardiopcgai.189.uz,localhost,127.0.0.1
LOG_LEVEL=info
DOCS_ENABLED=false

DATABASE_URL=postgresql+asyncpg://cardiopcg_app:<POSTGRES_PASSWORD>@postgres:5432/cardiopcg
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
CELERY_BROKER_URL=redis://:<REDIS_PASSWORD>@redis:6379/1
JOB_RUNNER=celery

STORAGE_BACKEND=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET_AUDIO=pcg-audio
S3_BUCKET_REPORTS=pcg-reports
S3_ACCESS_KEY=<MINIO_APP_ACCESS_KEY>
S3_SECRET_KEY=<MINIO_APP_SECRET_KEY>
# local-disk fallback (dev only): STORAGE_BACKEND=local, STORAGE_LOCAL_DIR=./storage

JWT_SECRET=<GENERATE_64_HEX: openssl rand -hex 32>
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
PASSWORD_PEPPER=<GENERATE_32_CHAR_RANDOM>
PII_ENCRYPTION_KEY=<BASE64_OF_32_RANDOM_BYTES: openssl rand -base64 32>
PII_HASH_PEPPER=<GENERATE_32_CHAR_RANDOM>

CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_REQUIRED=true

# real analysis engine (app.ml + app.services.ai); empty key => AI degrades to rule template / "unavailable"
ANALYSIS_SERVICE_IMPL=app.services.ai_adapter:build
DEEPSEEK_API_KEY=<SET_ON_SERVER_ONLY>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
