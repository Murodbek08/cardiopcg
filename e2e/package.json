{
  "name": "cardiopcg-e2e",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Playwright end-to-end tests for CardioPCG AI (run against deploy/docker-compose.dev.yml)",
  "scripts": {
    "setup": "bash scripts/setup-e2e.sh",
    "gen:wav": "node scripts/gen-wav.mjs",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
